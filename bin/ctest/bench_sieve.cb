# v0.8.2
@import <base>
def main() {
    auto t1 = Time.Now()
    const_ptr int limit = 20000000
    const int count = 0

    for i in range(2, *limit) {
        const bool is_prime = true
        const int j = 2
        while (*j * *j) <= i {
            if (i - (i / *j) * *j) == 0 { *is_prime = false; break; }
            j++
        }
        if *is_prime count++
    }
    auto t2 = Time.Now()
    println!("Primes found: {}", &count)
    println!("Total time on v0.8.2 Stable is {} seconds", Time.Elapsed(*t1, *t2))

    ret 0
}

#v0.8.2