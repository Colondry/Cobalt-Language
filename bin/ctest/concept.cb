def Multiply(nunique const int a, nunique int b = 555000555): int {
    if b == 555000555 then b = a
    ret a * b
}

def main() {
    println!("{}", Multiply(6))
    println!("{}", Multiply(10, 10))
    println!("{}", *Mul.x)
    ret 0
}

class Mul {
    public {
        int x = 0
    }
}

@import <std::csm>