@import <std::csm>

def inline getNum(): int { 
    int a = 9 * 9 * 9;
    ret *a * *a * *a;
}
def getNum2(): int: ret getNum() * getNum(); # counts as inline

def main(): int {
    if 10 > 9 then println!("ello")
    elif 18 < 9 then println!("ello")
    elif 10 == 9 then println!("ello")
    elif 10 <= 9 then println!("ello")
    else then println!("done!")

    int x = 9.55
    if ~<int>(*x) > 8 then println!("x is more than 8")
    println!("{}", ~<int>(*x))

    frac<int> fi = {9, 8}
    println!("{}", *fi)

    ret 0
}