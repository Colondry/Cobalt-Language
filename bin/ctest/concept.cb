@import <std::csm>
class Math {
    public {
        int x = 0
        int y = 0

        init(int x_ = 0, int y_ = 0) {
            this.x = x_
            this.y = y_
        }

        def add(): int {
            ret x + y
        }
    }
}

def main() {
    new m1 = Math{}
    new m2 = Math{10, 8}
    new m3 = Math{5}

    println!("{}", m1.add())   # 0
    println!("{}", m2.add())   # 18
    println!("{}", m3.add())   # 5

    ret 0
}